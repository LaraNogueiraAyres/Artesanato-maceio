  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteracaoBarraca
  nomeBarraca: Barraca de Bebidas
  mensagem: "Bem-vindo \xE0 barraca de bebidas! Hoje tem suco gelado de fruta da terra. Resolva o desafio e leve o seu!"
  nomeItem: Suco
  quantidadeItem: 3
  preco: 24
  idObjetivo: bebidas
  textoObjetivo: Comprar 3 sucos
  ordem: 0
  pergunta: "Um suco custa R$ 8,00. Voc\xEA compra 3 sucos e paga com R$ 100,00. Quanto recebe de troco?"
  alternativas:
  - R$ 74,00
  - R$ 76,00
  - R$ 80,00
  - R$ 82,00
  respostaCorreta: 1
  curiosidade: "Alagoas tem frutas tropicais como caju, acerola e caj\xE1, que viram sucos refrescantes. Nas feiras e praias, a \xE1gua de coco gelada tamb\xE9m \xE9 muito querida."
