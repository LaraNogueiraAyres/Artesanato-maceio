  m_EditorClassIdentifier: Assembly-CSharp::InteracaoBarraca
  nomeBarraca: "Barraca de Vestidos de Fil\xE9"
  mensagem: "Seja bem-vindo! Nossos vestidos s\xE3o de fil\xE9, bordado \xE0 m\xE3o pelas rendeiras. Hoje tem promo\xE7\xE3o!"
  somenteInformativo: 0
  ehMissao: 1
  nomeItem: "Vestido de fil\xE9"
  quantidadeItem: 1
  preco: 31
  idObjetivo: vestido
  textoObjetivo: "Comprar 1 vestido de fil\xE9"
  ordem: 0
  pergunta: "Um vestido de fil\xE9 custa R$ 62,00. Hoje ele est\xE1 sendo vendido por 1/2 do valor. Quanto voc\xEA paga?"
  alternativas:
  - R$ 22,00
  - R$ 24,00
  - R$ 31,00
  - R$ 36,00
  respostaCorreta: 2
  curiosidade: "O fil\xE9 \xE9 um bordado feito \xE0 m\xE3o sobre uma rede, tradicional de Alagoas. As rendeiras do Pontal da Barra, em Macei\xF3, passam essa arte de gera\xE7\xE3o em gera\xE7\xE3o"
