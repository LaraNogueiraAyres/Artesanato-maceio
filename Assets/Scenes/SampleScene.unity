    - target: {fileID: 3666470420520785052, guid: 86aa417cc067ade4197a784ad374900a, type: 3}
      propertyPath: mensagem
      value: "Ol\xE1! Aqui a tapioca \xE9 feita na hora, quentinha. Resolva a conta e leve a sua!"
      objectReference: {fileID: 0}
    - target: {fileID: 3666470420520785052, guid: 86aa417cc067ade4197a784ad374900a, type: 3}
      propertyPath: pergunta
      value: "Uma tapioca de coco custa R$ 3,00 e uma de queijo custa R$ 5,00. Voc\xEA compra as duas. Quanto vai pagar?"
      objectReference: {fileID: 0}
    - target: {fileID: 3666470420520785052, guid: 86aa417cc067ade4197a784ad374900a, type: 3}
      propertyPath: curiosidade
      value: "A tapioca \xE9 feita com a goma da mandioca, uma receita de origem ind\xEDgena. No Nordeste ela \xE9 comida de caf\xE9 da manh\xE3 e de lanche, recheada com coco ralado, queijo coalho ou carne de sol."
      objectReference: {fileID: 0}
    - target: {fileID: 3666470420520785052, guid: 86aa417cc067ade4197a784ad374900a, type: 3}
      propertyPath: textoObjetivo
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 3666470420520785052, guid: 86aa417cc067ade4197a784ad374900a, type: 3}
      propertyPath: quantidadeItem
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 3666470420520785052, guid: 86aa417cc067ade4197a784ad374900a, type: 3}
      propertyPath: respostaCorreta
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3666470420520785052, guid: 86aa417cc067ade4197a784ad374900a, type: 3}
      propertyPath: 'alternativas.Array.data[0]'
      value: R$ 8,00
      objectReference: {fileID: 0}
