  nomeBarraca: "Barraca de \xCDm\xE3"
  mensagem: "Bem-vindo \xE0 barraca de im\xE3s! Leve uma lembran\xE7a de Macei\xF3 para a sua casa!"
  somenteInformativo: 0
  ehMissao: 0
  nomeItem: "\xCDm\xE3"
  quantidadeItem: 1
  preco: 8
  idObjetivo: ima
