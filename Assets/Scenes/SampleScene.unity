  m_Script: {fileID: 11500000, guid: 1e29c4abfc80bfd4fb0db56fc868584f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteracaoBarraca
  nomeBarraca: Monumento ao Guerreiro Alagoano
  mensagem: "Seja bem-vindo! Nossos vestidos s\xE3o de fil\xE9, bordado \xE0 m\xE3o pelas rendeiras. Hoje tem promo\xE7\xE3o!"
  somenteInformativo: 1
  ehMissao: 0
  nomeItem: "Vestido de fil\xE9"
  quantidadeItem: 1
  preco: 31
  idObjetivo: monumento
  textoObjetivo: "Comprar 1 vestido de fil\xE9"
  ordem: 0
  pergunta: "Um vestido de fil\xE9 custa R$ 62,00. Hoje ele est\xE1 sendo vendido por 1/2 do valor. Quanto voc\xEA paga?"
  alternativas:
  - R$ 22,00
  - R$ 24,00
  - R$ 31,00
  - R$ 36,00
  respostaCorreta: 2
  curiosidade: "O Guerreiro \xE9 um dos folguedos mais tradicionais de Alagoas, apresentado em festas de Natal e Reis, com m\xFAsica, dan\xE7a e cantoria. Os brincantes usam chap\xE9us altos enfeitados com espelhos, fitas e flores. Foi reconhecido como Patrim\xF4nio Cultural Imaterial de Alagoas em 2019."
