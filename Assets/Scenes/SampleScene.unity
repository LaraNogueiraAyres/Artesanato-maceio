  m_Script: {fileID: 11500000, guid: 1e29c4abfc80bfd4fb0db56fc868584f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteracaoBarraca
  nomeBarraca: Barraca de Bonecos
  mensagem: "Seja bem-vindo \xE0 banca dos bonecos da Ilha do Ferro! Cada pe\xE7a \xE9 esculpida \xE0 m\xE3o. Vamos \xE0 conta?"
  somenteInformativo: 0
  ehMissao: 1
  nomeItem: Boneco da Ilha do Ferro
  quantidadeItem: 1
  preco: 8
  idObjetivo: bonecos
  textoObjetivo: Comprar 1 boneco da Ilha do Ferro
  ordem: 4
  pergunta: "O artes\xE3o cobra R$ 1,00 por cm\xB2 da base de madeira do boneco. A base \xE9 um ret\xE2ngulo de 4 cm por 2 cm. Quanto voc\xEA paga?"
  alternativas:
  - R$ 6,00
  - R$ 12,00
  - R$ 16,00
  - R$ 8,00
  respostaCorreta: 3
  curiosidade: "Essas pe\xE7as v\xEAm da Ilha do Ferro, uma comunidade \xE0s margens do Rio S\xE3o Francisco, em Alagoas. O lugar ficou conhecido pelo talento de seus artes\xE3os."
