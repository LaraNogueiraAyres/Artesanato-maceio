  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteracaoBarraca
  nomeBarraca: Barraca de Tapioca
  mensagem: "Bem-vindo \xE0 barraca de tapioca! Aqui a massa \xE9 feita na hora, quentinha, com coco, queijo ou carne de sol."
  nomeItem: Tapioca
  quantidadeItem: 4
  preco: 12
  idObjetivo: tapioca
  textoObjetivo: Comprar 4 tapiocas
  ordem: 2
  pergunta: Cada tapioca custa R$ 3,00. Quanto custam 4 tapiocas?
  alternativas:
  - R$ 9,00
  - R$ 10,00
  - R$ 12,00
  - R$ 15,00
  respostaCorreta: 2
  curiosidade: "A tapioca \xE9 feita da goma da mandioca, um alimento herdado dos povos ind\xEDgenas, e \xE9 um dos caf\xE9s da manh\xE3 mais queridos do Nordeste."
